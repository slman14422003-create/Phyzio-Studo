<?xml version="1.0" encoding="utf-8"?>
<!-- "Cloud files" screen: free storage for PDFs/documents through a Cloudflare Worker + R2 (upload / open / rename / replace / delete). See cloudflare-worker/README.md at the repository root for deployment. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Phizyo.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:navigationIcon="@drawable/ic_arrow_back">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                style="@style/Phizyo.HeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_cloud_files" />

            <TextView
                android:id="@+id/header_subtitle"
                style="@style/Phizyo.HeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Fix note: the loading bar and the error bar used to be inside cloud_content, so when the screen was in the "not configured" state (content hidden) any connection or loading error after setting the link never appeared and the button/screen looked broken. They were moved outside it. -->
    <!-- Worker connection status bar (shown only on error or while loading) -->
    <LinearLayout
        android:id="@+id/cloud_status_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginEnd="@dimen/space_16"
        android:background="@drawable/bg_glass_card_warning"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_12"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_alert"
            android:tint="@color/accent_red" />

        <TextView
            android:id="@+id/cloud_status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:textAlignment="viewStart"
            android:textColor="@color/text_primary"
            android:textDirection="rtl"
            android:textSize="13.5sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/cloud_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:indeterminateTint="@color/primary_cyan"
        android:visibility="gone" />


    <!-- Upload card (Claude style): file icon + name + percentage and size + real progress bar + cancel button. It switches to an "uploaded" state and then hides automatically. -->
    <LinearLayout
        android:id="@+id/upload_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginEnd="@dimen/space_16"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_avatar_circle">

                <ImageView
                    android:id="@+id/upload_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_folder"
                    android:tint="@color/primary_cyan" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/upload_name"
                    style="@style/Phizyo.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    android:textDirection="firstStrong"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/upload_status"
                    style="@style/Phizyo.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAlignment="viewStart"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/upload_cancel"
                style="@style/Phizyo.IconButton"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:contentDescription="@string/ui_cancel_upload"
                android:padding="14dp"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/upload_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="@dimen/space_12"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/bg_upload_progress" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/cloud_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/cloud_files_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingStart="@dimen/space_16"
                android:paddingTop="14dp"
                android:paddingEnd="@dimen/space_16"
                android:paddingBottom="100dp" />
        </LinearLayout>

        <include
            android:id="@+id/empty_hint_container"
            layout="@layout/view_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fab_upload"
            style="@style/Widget.Material3.ExtendedFloatingActionButton.Icon.Primary"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:contentDescription="@string/ui_upload_new_file"
            android:text="@string/ui_upload_file"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary_cyan"
            app:cornerRadius="@dimen/radius_large"
            app:elevation="2dp"
            app:icon="@drawable/ic_add"
            app:iconTint="@color/white" />
    </FrameLayout>
</LinearLayout>
