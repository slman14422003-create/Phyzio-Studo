<?xml version="1.0" encoding="utf-8"?>
<!-- A single page inside the PDF reader: a sheet (bg_pdf_page) holding the page image + a transparent highlight layer (read aloud and search results), with the page number below it (and a ★ if bookmarked). Total horizontal sheet margins = 26dp (12+12 margin + 1+1 padding); see PAGE_CARD_HORIZONTAL_CHROME_DP. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="2dp"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pdf_page"
        android:paddingStart="1dp"
        android:paddingTop="1dp"
        android:paddingEnd="1dp"
        android:paddingBottom="3dp">

        <ImageView
            android:id="@+id/pdf_page_image"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:adjustViewBounds="true"
            android:background="@color/white"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />

        <com.ast2012a.clinicalmaster.PdfHighlightView
            android:id="@+id/pdf_page_highlight"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <TextView
        android:id="@+id/pdf_page_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="@color/text_tertiary"
        android:textSize="11.5sp"
        android:textStyle="bold" />
</LinearLayout>
