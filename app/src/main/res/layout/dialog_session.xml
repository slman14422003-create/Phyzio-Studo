<?xml version="1.0" encoding="utf-8"?>
<!-- Record / edit a session dialog -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/dlg_title"
            style="@style/Phizyo.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_16"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/dlg_date"
            style="@style/Phizyo.Button.Secondary"
            android:layout_marginBottom="@dimen/space_12" />

        <!-- Protocol field: tapping it (or the arrow) opens a searchable picker instead of the old dropdown, which only appeared after typing. -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/dlg_protocol_layout"
            style="@style/Phizyo.Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ui_session_protocol"
            app:endIconDrawable="@drawable/ic_chevron_down"
            app:endIconMode="custom"
            app:endIconTint="@color/text_secondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/dlg_protocol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="false"
                android:inputType="none"
                android:longClickable="false"
                android:textAlignment="viewStart"
                android:textColor="@color/text_primary"
                android:textDirection="rtl"
                android:textSize="14.5sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Phizyo.Field"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="@string/ui_duration_min">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/dlg_duration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="3"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_primary"
                    android:textDirection="ltr"
                    android:textSize="@dimen/text_body" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Phizyo.Field"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="@string/ui_session_fee">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/dlg_fee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_primary"
                    android:textDirection="ltr"
                    android:textSize="@dimen/text_body" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Phizyo.Field"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="@string/ui_pain_before">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/dlg_pain_before"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="2"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_primary"
                    android:textDirection="ltr"
                    android:textSize="@dimen/text_body" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Phizyo.Field"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="@string/ui_pain_after">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/dlg_pain_after"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="2"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_primary"
                    android:textDirection="ltr"
                    android:textSize="@dimen/text_body" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Phizyo.Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:hint="@string/ui_session_notes">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/dlg_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2"
                android:textAlignment="viewStart"
                android:textColor="@color/text_primary"
                android:textDirection="rtl"
                android:textSize="@dimen/text_body" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dlg_save"
                style="@style/Phizyo.Button.Primary"
                android:layout_width="0dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:text="@string/ui_save" />

            <TextView
                android:id="@+id/dlg_cancel"
                style="@style/Phizyo.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:text="@string/ui_cancel" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
