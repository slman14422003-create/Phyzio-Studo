<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Settings.Row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/vrow_icon"
        style="@style/Settings.RowIcon"
        android:layout_width="24dp"
        android:layout_height="24dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/vrow_title"
            style="@style/Settings.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/vrow_sub"
            style="@style/Settings.RowSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <ImageView
        android:id="@+id/vrow_chevron"
        style="@style/Settings.RowChevron"
        android:layout_width="20dp"
        android:layout_height="20dp" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/vrow_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />
</LinearLayout>
