<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/schedule_banner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_tile"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_icon_tint_soft">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_calendar"
            android:tint="@color/primary_cyan_dark" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            style="@style/Phizyo.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="جدول الجلسات"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/banner_sub"
            style="@style/Phizyo.Body.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12.5sp" />
    </LinearLayout>

    <ImageView
        style="@style/Settings.RowChevron"
        android:layout_width="16dp"
        android:layout_height="16dp" />
</LinearLayout>
