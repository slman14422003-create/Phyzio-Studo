<?xml version="1.0" encoding="utf-8"?>
<!-- Privacy policy screen, redesigned in the Claude style: welcome header with a shield icon, then each section in a rounded card (icon + title + text). The text itself did not change. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Phizyo.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/ui_privacy_policy" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_16"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/space_16"
            android:paddingBottom="28dp">

            <!-- Welcome header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_12">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_shield"
                    android:tint="@color/claude_orange" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:text="@string/ui_pp_hero_title"
                    android:textColor="@color/text_primary"
                    android:textDirection="rtl"
                    android:textSize="25sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/ui_pp_hero_body"
                    android:textColor="@color/text_secondary"
                    android:textDirection="rtl"
                    android:textSize="14.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:background="@drawable/bg_settings_group"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_info"
                        android:tint="@color/primary_cyan" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="@string/ui_pp_overview"
                        android:textAlignment="viewStart"
                        android:textColor="@color/text_primary"
                        android:textDirection="rtl"
                        android:textSize="@dimen/text_title"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:lineSpacingExtra="5dp"
                    android:text="@string/ui_pp_overview_body"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_secondary"
                    android:textDirection="rtl"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:background="@drawable/bg_settings_group"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_smartphone"
                        android:tint="@color/primary_cyan" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="@string/ui_pp_local_title"
                        android:textAlignment="viewStart"
                        android:textColor="@color/text_primary"
                        android:textDirection="rtl"
                        android:textSize="@dimen/text_title"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:lineSpacingExtra="5dp"
                    android:text="@string/ui_pp_local_body"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_secondary"
                    android:textDirection="rtl"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:background="@drawable/bg_settings_group"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_wifi"
                        android:tint="@color/primary_cyan" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="@string/ui_pp_online_title"
                        android:textAlignment="viewStart"
                        android:textColor="@color/text_primary"
                        android:textDirection="rtl"
                        android:textSize="@dimen/text_title"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:lineSpacingExtra="5dp"
                    android:text="@string/ui_pp_online_body"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_secondary"
                    android:textDirection="rtl"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:background="@drawable/bg_settings_group"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_cloud"
                        android:tint="@color/primary_cyan" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="@string/ui_pp_backup_title"
                        android:textAlignment="viewStart"
                        android:textColor="@color/text_primary"
                        android:textDirection="rtl"
                        android:textSize="@dimen/text_title"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:lineSpacingExtra="5dp"
                    android:text="@string/ui_pp_backup_body"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_secondary"
                    android:textDirection="rtl"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:background="@drawable/bg_settings_group"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_cloud"
                        android:tint="@color/primary_cyan" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="@string/ui_pp_worker_title"
                        android:textAlignment="viewStart"
                        android:textColor="@color/text_primary"
                        android:textDirection="rtl"
                        android:textSize="@dimen/text_title"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:lineSpacingExtra="5dp"
                    android:text="@string/ui_pp_worker_body"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_secondary"
                    android:textDirection="rtl"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:background="@drawable/bg_settings_group"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ban"
                        android:tint="@color/primary_cyan" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="@string/ui_pp_noads_title"
                        android:textAlignment="viewStart"
                        android:textColor="@color/text_primary"
                        android:textDirection="rtl"
                        android:textSize="@dimen/text_title"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:lineSpacingExtra="5dp"
                    android:text="@string/ui_pp_noads_body"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_secondary"
                    android:textDirection="rtl"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:background="@drawable/bg_settings_group"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_message"
                        android:tint="@color/primary_cyan" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="@string/ui_pp_contact_title"
                        android:textAlignment="viewStart"
                        android:textColor="@color/text_primary"
                        android:textDirection="rtl"
                        android:textSize="@dimen/text_title"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:lineSpacingExtra="5dp"
                    android:text="@string/ui_pp_contact_body"
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_secondary"
                    android:textDirection="rtl"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
