<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/voice_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginBottom="76dp"
    android:background="@drawable/bg_pdf_nav_bar"
    android:elevation="6dp"
    android:layoutDirection="ltr"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/voice_prev"
            style="@style/Phizyo.IconButton"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:contentDescription="@string/vs_prev_para"
            android:padding="12dp"
            android:src="@drawable/ic_skip_prev" />

        <ImageButton
            android:id="@+id/voice_play"
            style="@style/Phizyo.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/vs_pause"
            android:padding="11dp"
            android:src="@drawable/ic_pause" />

        <ImageButton
            android:id="@+id/voice_next"
            style="@style/Phizyo.IconButton"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:contentDescription="@string/vs_next_para"
            android:padding="12dp"
            android:src="@drawable/ic_skip_next" />

        <ImageButton
            android:id="@+id/voice_stop"
            style="@style/Phizyo.IconButton"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:contentDescription="@string/vs_stop"
            android:padding="12dp"
            android:src="@drawable/ic_stop" />

        <TextView
            android:id="@+id/voice_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/voice_speed_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="40dp"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/voice_speed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/vs_speed_desc"
        android:max="8"
        android:progress="3"
        android:progressTint="@color/primary_cyan"
        android:thumbTint="@color/primary_cyan" />
</LinearLayout>
