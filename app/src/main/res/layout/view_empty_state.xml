<?xml version="1.0" encoding="utf-8"?>
<!-- Unified empty state: icon + title + description + action button (texts are filled from Java) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingEnd="32dp">

    <com.ast2012a.clinicalmaster.IllustrationView
        android:id="@+id/empty_illustration"
        android:layout_width="match_parent"
        android:layout_height="150dp" />

    <ImageView
        android:id="@+id/empty_icon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <TextView
        android:id="@+id/empty_title"
        style="@style/Phizyo.HeroTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:textAlignment="center"
        android:textSize="@dimen/text_header" />

    <TextView
        android:id="@+id/empty_body"
        style="@style/Phizyo.Body.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:textAlignment="center" />

    <TextView
        android:id="@+id/empty_action"
        style="@style/Phizyo.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:minWidth="200dp" />
</LinearLayout>
