    <style name="Phizyo.HomeTile" parent="">
        <item name="android:background">@drawable/bg_tile</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:stateListAnimator">@animator/press_scale_xy</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:drawableTint">@color/primary_cyan_dark</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">58dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textDirection">rtl</item>
        <item name="android:textSize">14.5sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Phizyo.HomeSection" parent="">
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textDirection">rtl</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
