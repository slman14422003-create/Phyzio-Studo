<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".ClinicalMasterApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClinicalMaster">

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.ClinicalMaster.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- configChanges: the main search screen hosts the quick "Ask Semo AI" box and may have a long AI request (including several auto-continue rounds taking minutes) running. Without configChanges a rotation destroys and recreates the activity, onDestroy calls executor.shutdownNow() and cuts the running network call, so the user gets a truncated or empty reply even though AiOrchestrator.sendWithAutoContinue works correctly. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:exported="false"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".CaseDetailActivity" android:exported="false" />
        <activity android:name=".AddEditCaseActivity" android:exported="false" />
        <activity android:name=".MyCasesActivity" android:exported="false" />
        <activity android:name=".FavoritesActivity" android:exported="false" />
        <activity android:name=".UserGuideActivity" android:exported="false" />
        <activity android:name=".PatientsActivity" android:exported="false" />
        <activity android:name=".AddEditPatientActivity" android:exported="false" />
        <activity android:name=".PatientDetailActivity" android:exported="false" />
        <activity android:name=".TreatmentProgramsActivity" android:exported="false" />
        <activity android:name=".AddEditTreatmentProgramActivity" android:exported="false" />
        <activity android:name=".TreatmentProgramDetailActivity" android:exported="false" />
        <activity android:name=".SettingsActivity" android:exported="false" />
        <activity android:name=".SemoLibraryActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".PrivacyPolicyActivity" android:exported="false" />
        <!-- configChanges: same reason as MainActivity above. The full chat screen is the most exposed to the problem (long clinical replies with several continue rounds, and users tend to rotate the device while waiting). -->
        <activity android:name=".AiAssistantActivity" android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".CloudStorageActivity" android:exported="false" />
        <activity android:name=".CrashActivity" android:exported="false" />

        <!-- PDF reader: opened from cloud files, from the "PDF Reader" button, or as an "Open with" choice for any PDF file. -->
        <activity
            android:name=".PdfViewerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:exported="true"
            android:label="@string/ui_pdf_reader">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!-- Sharing the downloaded APK with the system installer (app update from GitHub). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>

        <!-- Background update download (foreground service with a progress notification). -->
        <service
            android:name=".UpdateDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Morning alert listing today's session patients: daily alarm plus rescheduling after reboot or app update. -->
        <receiver android:name=".SessionReminderReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
